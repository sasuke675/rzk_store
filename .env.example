# Environment Variables untuk Frontend (Vite)
# Salin file ini menjadi .env lalu isi nilainya
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Environment Variables untuk Backend / Webhook Callback (Netlify)
# Konfigurasikan variabel berikut di panel pengaturan Netlify Environment Variables
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key...
CALLBACK_SECRET_KEY=masukkan_token_keamanan_disini
